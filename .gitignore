node_modules/

# Book PDFs are paid products and never go in the repo; everything rendered from
# them is regenerated by the pipeline (render_pages.sh, crop_cutouts.py).
assets/pdf/*
assets/pages/*
assets/cutouts/*

# Voiceover, music and footage are large binaries supplied per production.
assets/audio/vo/*
assets/audio/vo-clean/*
assets/audio/music/*
assets/footage/*
assets/proxies/*

# Renders
out/*/*

!**/.gitkeep
